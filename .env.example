# Server-side only. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-your-project-key
OPENAI_MODEL=gpt-5.6-sol
NEXT_PUBLIC_SITE_URL=https://mastery-platform.onrender.com

# Recommended independent key for sealing short-lived evaluation payloads.
MASTERY_TOKEN_SECRET=replace-with-a-long-random-value

# Render production should remain false unless an isolated Spark container runtime is configured.
PYSPARK_RUNTIME_ENABLED=false
PYSPARK_RUNTIME_ISOLATION=container
PYSPARK_RUNTIME_MAX_CONCURRENCY=2

# Optional Python runtime override.
PYTHON_BIN=python3
